{
    "name": "esign/shopify-data",
    "description": "Typed DTOs, Inputs and Enums for the Shopify Admin GraphQL API, versioned per Shopify API release",
    "keywords": [
        "shopify",
        "graphql",
        "dto",
        "admin-api"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cedric Vleminckx",
            "email": "cedric.vleminckx@dynamate.be",
            "role": "Developer"
        },
        {
            "name": "Lorenzo Verheecke",
            "email": "lorenzo.verheecke@dynamate.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.3",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Esign\\ShopifyData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esign\\ShopifyData\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
